      "SRC := ${3}",
      "",
      "all: $(TARGET)",
      "",
      "rebuild: clean all",
      "",
      "clean:",
      " @rm -rf $(BUILD)",
      "",
      ".PHONY: clean, all"
    ],
    "prefix": "template",
    "description": "Makefile template",
    "scope": "make"
  },
